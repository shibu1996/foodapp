{
  "name": "@restaurant-app/api",
  "version": "1.0.0",
  "main": "src/index.js",
  "type": "module",
  "scripts": {
    "dev": "nodemon src/index.js",
    "start": "node src/index.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:dev": "pm2 start ecosystem.config.js:restaurant-api-dev",
    "pm2:stop": "pm2 stop restaurant-api",
    "pm2:restart": "pm2 restart restaurant-api",
    "pm2:reload": "pm2 reload restaurant-api",
    "pm2:delete": "pm2 delete restaurant-api",
    "pm2:logs": "pm2 logs restaurant-api",
    "pm2:monit": "pm2 monit",
    "prod": "pm2 start ecosystem.config.js --env production",
    "seed:products": "node src/modules/food/utils/seedProducts.js",
    "seed:categories": "node src/modules/food/utils/seedCategories.js",
    "seed:all": "npm run seed:categories && npm run seed:products"
  },
  "dependencies": {
    "bull": "^4.12.0",
    "compression": "^1.7.4",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "express-rate-limit": "^7.1.5",
    "helmet": "^7.1.0",
    "ioredis": "^5.3.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "pm2": "^5.3.0",
    "rate-limit-redis": "^4.2.0",
    "razorpay": "^2.9.6",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1"
  },
  "devDependencies": {
    "nodemon": "^3.0.2"
  }
}
