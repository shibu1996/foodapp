{
  "name": "@restaurant-app/api",
  "version": "1.0.0",
  "main": "dist/index.js",
  "scripts": {
    "dev": "ts-node-dev --respawn --transpile-only src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "pm2:start": "pm2 start ecosystem.config.js --env production",
    "pm2:dev": "pm2 start ecosystem.config.js:restaurant-api-dev",
    "pm2:stop": "pm2 stop restaurant-api",
    "pm2:restart": "pm2 restart restaurant-api",
    "pm2:reload": "pm2 reload restaurant-api",
    "pm2:delete": "pm2 delete restaurant-api",
    "pm2:logs": "pm2 logs restaurant-api",
    "pm2:monit": "pm2 monit",
    "prod": "npm run build && pm2 start ecosystem.config.js --env production",
    "seed:products": "ts-node src/modules/food/utils/seedProducts.ts",
    "seed:categories": "ts-node src/modules/food/utils/seedCategories.ts",
    "seed:all": "npm run seed:categories && npm run seed:products"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.0.3",
    "ioredis": "^5.3.2",
    "compression": "^1.7.4",
    "helmet": "^7.1.0",
    "express-rate-limit": "^7.1.5",
    "rate-limit-redis": "^4.2.0",
    "bull": "^4.12.0",
    "winston": "^3.11.0",
    "winston-daily-rotate-file": "^4.7.1",
    "pm2": "^5.3.0"
  },
  "devDependencies": {
    "@types/bull": "^4.10.0",
    "@types/compression": "^1.7.5",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.5",
    "@types/node": "^20.10.5",
    "ts-node": "^10.9.2",
    "ts-node-dev": "^2.0.0",
    "typescript": "^5.3.3"
  }
}
